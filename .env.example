# Example environment variables for Gleisplanextraktor
# Copy this file to .env and fill in your actual values
#
# This configuration is designed for company laptops without Docker or PostgreSQL.
# Uses SQLite for local database storage.

# ============================================================================
# DATABASE CONFIGURATION (SQLite - no Docker required)
# ============================================================================
# Path to SQLite database file (will be created automatically)
# If not set, defaults to track_layouts.db in the project root
DATABASE_PATH=./track_layouts.db

# ============================================================================
# TOOL PATHS (Required for company laptops without system PATH access)
# ============================================================================

# Poppler path for PDF processing (pdf2image)
# Download from: https://github.com/oschwartz10612/poppler-windows/releases (Windows)
# Or install via package manager (Linux/macOS)
#
# Windows examples:
#   POPPLER_PATH=C:/Program Files/poppler-24.02.0/Library/bin
#   POPPLER_PATH=C:/Tools/poppler/bin
#
# Linux examples:
#   POPPLER_PATH=/usr/bin
#   POPPLER_PATH=/opt/poppler/bin
#
# macOS (Homebrew):
#   POPPLER_PATH=/opt/homebrew/bin
POPPLER_PATH=

# Tesseract path for OCR (only needed if using Tesseract engine)
# Download from: https://github.com/UB-Mannheim/tesseract/wiki (Windows)
# Note: Default OCR engine is PaddleOCR, Tesseract is optional
#
# Windows examples:
#   TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
#
# Linux examples:
#   TESSERACT_PATH=/usr/bin/tesseract
#
# macOS (Homebrew):
#   TESSERACT_PATH=/opt/homebrew/bin/tesseract
TESSERACT_PATH=

# ============================================================================
# YOLO MODEL CONFIGURATION
# ============================================================================
# Path to YOLO model weights file
YOLO_MODEL_PATH=./yolomodel/best.pt

# Detection confidence threshold (0.0 - 1.0)
YOLO_CONFIDENCE=0.25

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Enable debug mode for verbose logging
DEBUG_MODE=False

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# OCR CONFIGURATION
# ============================================================================
# OCR engine to use: paddleocr, tesseract, easyocr
# Default is paddleocr (recommended, no additional installation needed)
OCR_ENGINE=paddleocr
